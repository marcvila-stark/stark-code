{
  "manifest_version": 3,
  "name": "Stark Code Capture",
  "version": "0.1.1",
  "description": "Review selected text, images and screenshot regions, then add them to a Stark Code chat draft.",
  "minimum_chrome_version": "127",
  "key": "",
  "permissions": ["activeTab", "contextMenus", "scripting", "nativeMessaging", "storage"],
  "action": {
    "default_title": "Add to Stark Code",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icon.png"
    }
  },
  "icons": {
    "32": "icon.png"
  },
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "commands": {
    "capture-region": {
      "description": "Capture a page region for Stark Code"
    }
  }
}
